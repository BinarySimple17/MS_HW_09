    {
      "name": "check balance success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responseData = pm.response.json();\r",
              "\r",
              "pm.test(\"Статус 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "var newBalance = pm.collectionVariables.get(\"balancePrev\") - pm.collectionVariables.get(\"orderPrice\");\r",
              "\r",
              "pm.test(\"Деньги за заказ уплачены один раз\", function () {\r",
              "   pm.expect(responseData.balance).to.equal(newBalance);\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"balancePrev\", responseData.balance);"
            ],
