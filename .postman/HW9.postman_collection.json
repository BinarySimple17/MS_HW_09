      "name": "register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responseData = pm.response.json();\r",
              "\r",
              "pm.test(\"Статус 201 OK\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"userToken\", responseData.accessToken);\r",
              "pm.collectionVariables.set(\"depositAmount\", 150);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
