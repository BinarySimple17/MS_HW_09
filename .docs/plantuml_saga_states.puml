@startuml
[*] --> STARTED

state STARTED
state PAYMENT_PROCESSING
state PAID
state WAREHOUSE_RESERVING
state WAREHOUSE_RESERVED
state DELIVERY_SCHEDULING
state DELIVERY_SCHEDULED
state COMPLETED

state PAYMENT_FAILED
state WAREHOUSE_FAILED
state DELIVERY_FAILED
state COMPENSATING
state COMPENSATED

STARTED --> PAYMENT_PROCESSING
PAYMENT_PROCESSING --> PAID
PAID --> WAREHOUSE_RESERVING
WAREHOUSE_RESERVING --> WAREHOUSE_RESERVED
WAREHOUSE_RESERVED --> DELIVERY_SCHEDULING
DELIVERY_SCHEDULING --> DELIVERY_SCHEDULED
DELIVERY_SCHEDULED --> COMPLETED
COMPLETED --> [*]

PAYMENT_PROCESSING --> PAYMENT_FAILED
WAREHOUSE_RESERVING --> WAREHOUSE_FAILED
DELIVERY_SCHEDULING --> DELIVERY_FAILED

PAYMENT_FAILED --> COMPENSATING
WAREHOUSE_FAILED --> COMPENSATING
DELIVERY_FAILED --> COMPENSATING

COMPENSATING --> COMPENSATED
COMPENSATED --> [*]
@enduml